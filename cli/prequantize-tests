# ---------------------------------------------------------------------------
# The public rounding rule, exactly as documented in doc/pre-quantize.md.
# This is an INDEPENDENT restatement of the rule (not the C code); the
# hardcoded matrix above must agree with it, and the implementation must
# agree with the matrix.
# ---------------------------------------------------------------------------

def f32(v):
    return struct.unpack("<f", struct.pack("<f", v))[0]

def public_rule_int(sample, container_bits, q, rnd):
    if q >= container_bits:
        return sample                       # no-op: q at or above container depth
    quantum = 1 << (container_bits - q)
    s = sample
    if rnd:
        offset = quantum >> 1               # round half up ...
        if s < 0 or s + offset < (1 << (container_bits - 1)):
            s += offset                     # ... but never past positive full-scale
    return (s // quantum) * quantum         # floor toward -inf to a quantum multiple

def public_rule_float(f, q, norm_exp=127):
    f = f32(f)                              # the stored binary32 value is quantized
    v = math.floor(f * 2.0 ** (q + 126 - norm_exp) + 0.5) * 2.0 ** (norm_exp - 126 - q)
    return f32(v)                           # always rounds half up, never clips

failures = []
def check(cond, msg):
    if not cond:
        failures.append(msg)
        print("FAIL: %s" % msg)

# --- step 1: the hardcoded matrix must match the public rule on the inputs --

for (bits, q, rnd), exp in sorted(MATRIX.items(), key=str):
    src = INPUTS[bits]
    if bits == "f32":
        want = [round(public_rule_float(f, q), 9) for f in src]
    else:
        want = [public_rule_int(s, bits, q, rnd) for s in src]
    check(want == exp["samples"],
          "matrix cell (%s, %d, %s) disagrees with the documented public rule" % (bits, q, rnd))

# ---------------------------------------------------------------------------
# Helpers to generate inputs and run the tools.
# ---------------------------------------------------------------------------

def write_wav(path, bits, samples, floatfmt=False, rate=44100, nch=1):
    data = bytearray()
    if floatfmt:
        for s in samples:
            data += struct.pack("<f", s)
        fmt, bps = 3, 4
    else:
        for s in samples:
            if bits == 8:
                data += struct.pack("<B", s + 128)      # 8-bit WAV is unsigned
            elif bits == 16:
                data += struct.pack("<h", s)
            elif bits == 24:
                data += (s & 0xFFFFFF).to_bytes(3, "little")
            else:
                data += struct.pack("<i", s)
        fmt, bps = 1, (bits + 7) // 8
    block = nch * bps
    hdr = b"RIFF" + struct.pack("<I", 36 + len(data)) + b"WAVE"
    fmtc = b"fmt " + struct.pack("<IHHIIHH", 16, fmt, nch, rate, rate * block, block, bits)
    with open(path, "wb") as f:
        f.write(hdr + fmtc + b"data" + struct.pack("<I", len(data)) + data)

def write_dsf(path, payload, rate=2822400):
    n = len(payload)
    fmt = b"fmt " + struct.pack("<Q", 52) + struct.pack("<IIII", 1, 0, 1, 1) \
        + struct.pack("<II", rate, 1) + struct.pack("<QI", n * 8, 4096) + b"\x00" * 4
    dat = b"data" + struct.pack("<Q", 12 + n) + payload
    hdr = b"DSD " + struct.pack("<Q", 28) + struct.pack("<Q", 28 + 52 + 12 + n) + struct.pack("<Q", 0)
    with open(path, "wb") as f:
        f.write(hdr + fmt + dat)

def run(args):
    r = subprocess.run(args, capture_output=True, text=True)
    return r.returncode, r.stdout + r.stderr

def unpack_ints(payload, bits):
    if bits == 8:
        return [b - 128 for b in payload]
    if bits == 16:
        return list(struct.unpack("<%dh" % (len(payload) // 2), payload))
    if bits == 24:
        out = []
        for i in range(0, len(payload), 3):
            b = payload[i:i+3]
            out.append(int.from_bytes(b + (b"\xff" if b[2] & 0x80 else b"\x00"), "little", signed=True))
        return out
    return list(struct.unpack("<%di" % (len(payload) // 4), payload))

def stored_md5(wvpath):
    rc, out = run([WVUNPACK, "-s", wvpath])
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("original md5:"):
            return line.split()[2]
    return None

def wav_declared_bits(path):
    with open(path, "rb") as f:
        data = f.read(64)
    i = data.find(b"fmt ")
    return struct.unpack("<H", data[i + 22:i + 24])[0]

# --- step 2: end-to-end matrix verification (fresh encode -> decode) --------

for (bits, q, rnd), exp in sorted(MATRIX.items(), key=str):
    name = "in%s" % bits
    inwav = os.path.join(WORK, "%s.wav" % name)
    if not os.path.exists(inwav):
        write_wav(inwav, 32 if bits == "f32" else bits, INPUTS[bits], floatfmt=(bits == "f32"))
    wv = os.path.join(WORK, "%s_q%d_%d.wv" % (name, q, rnd))
    opt = "--pre-quantize-round=%d" % q if rnd else "--pre-quantize=%d" % q
    rc, out = run([WAVPACK, "-y", "-q", "-m", opt, inwav, "-o", wv])
    check(rc == 0, "encode failed for (%s, %d, %s): %s" % (bits, q, rnd, out.strip()))
    if rc != 0:
        continue
    check(stored_md5(wv) == exp["md5"],
          "stored MD5 mismatch for (%s, %d, %s): got %s, want %s" % (bits, q, rnd, stored_md5(wv), exp["md5"]))
    raw = os.path.join(WORK, "out.raw")
    rc, out = run([WVUNPACK, "-y", "-q", "-r", wv, "-o", raw])
    check(rc == 0, "decode failed for (%s, %d, %s): %s" % (bits, q, rnd, out.strip()))
    with open(raw, "rb") as f:
        payload = f.read()
    if bits == "f32":
        got = [round(v, 9) for v in struct.unpack("<%df" % (len(payload) // 4), payload)]
    else:
        got = unpack_ints(payload, bits)
    check(got == exp["samples"],
          "decoded samples mismatch for (%s, %d, %s): got %r, want %r" % (bits, q, rnd, got, exp["samples"]))
    # the MD5 stored in the stream must cover the quantized payload, i.e. it
    # must equal the MD5 of what the decoder actually outputs
    check(hashlib.md5(payload).hexdigest() == exp["md5"],
          "stored MD5 does not cover decoded payload for (%s, %d, %s)" % (bits, q, rnd))
    # lossless verification of the file must pass (MD5 is self-consistent)
    rc, out = run([WVUNPACK, "-q", "-v", wv])
    check(rc == 0, "wvunpack -v failed for (%s, %d, %s)" % (bits, q, rnd))

# --- step 3: declared bit depth is unchanged by pre-quantization ------------

for bits, q, rnd in [(8, 4, False), (16, 8, False), (24, 20, False), (32, 16, False)]:
    name = "in%s" % bits
    wv = os.path.join(WORK, "%s_q%d_%d.wv" % (name, q, rnd))
    outwav = os.path.join(WORK, "out.wav")
    rc, out = run([WVUNPACK, "-y", "-q", wv, "-o", outwav])
    check(rc == 0 and wav_declared_bits(outwav) == bits,
          "decoded file declares %d bits, want %d (pre-quantize must not change declared depth)" %
          (wav_declared_bits(outwav) if rc == 0 else -1, bits))

# --- step 4: re-encoding a .wv source applies the identical rule ------------

src24 = os.path.join(WORK, "in24.wv")
rc, out = run([WAVPACK, "-y", "-q", "-m", os.path.join(WORK, "in24.wav"), "-o", src24])
check(rc == 0, "plain 24-bit encode failed: %s" % out.strip())
rq = os.path.join(WORK, "in24_requant.wv")
rc, out = run([WAVPACK, "-y", "-q", "--pre-quantize=20", src24, "-o", rq])
check(rc == 0, "re-encode with --pre-quantize failed: %s" % out.strip())
exp = MATRIX[(24, 20, False)]
check(stored_md5(rq) == exp["md5"],
      "re-encoded MD5 mismatch: got %s, want %s" % (stored_md5(rq), exp["md5"]))
raw = os.path.join(WORK, "out.raw")
rc, out = run([WVUNPACK, "-y", "-q", "-r", rq, "-o", raw])
with open(raw, "rb") as f:
    got = unpack_ints(f.read(), 24)
check(got == exp["samples"], "re-encoded samples mismatch: got %r" % (got,))

# --- step 5: no-op cases warn, and DSD is never quantized --------------------

rc, out = run([WAVPACK, "-y", "-q", "--pre-quantize=24", os.path.join(WORK, "in24.wav"), "-o", os.path.join(WORK, "noop.wv")])
check(rc == 0 and "has no effect" in out, "expected no-op warning for --pre-quantize=24 on 24-bit source")

dsd_payload = bytes((i * 37 + 11) & 0xFF for i in range(4096 * 14))
dsf = os.path.join(WORK, "t.dsf")
write_dsf(dsf, dsd_payload)
raw = os.path.join(WORK, "out.raw")
# reference: plain encode/decode of the DSD source (bit-exact by definition)
refwv = os.path.join(WORK, "tref.wv")
rc, out = run([WAVPACK, "-y", "-q", dsf, "-o", refwv])
check(rc == 0, "plain DSD encode failed: %s" % out.strip())
rc, out = run([WVUNPACK, "-y", "-q", "-r", refwv, "-o", raw])
with open(raw, "rb") as f:
    dsd_reference = f.read()
# fresh encode with --pre-quantize: warns, payload untouched
dwv = os.path.join(WORK, "t.wv")
rc, out = run([WAVPACK, "-y", "-q", "--pre-quantize=4", dsf, "-o", dwv])
check(rc == 0 and "not applicable to DSD" in out, "expected DSD warning on fresh encode")
rc, out = run([WVUNPACK, "-y", "-q", "-r", dwv, "-o", raw])
with open(raw, "rb") as f:
    check(f.read() == dsd_reference, "DSD payload altered by --pre-quantize on fresh encode")
# re-encode with --pre-quantize: warns, payload untouched
rwv = os.path.join(WORK, "t2.wv")
rc, out = run([WAVPACK, "-y", "-q", "--pre-quantize=4", dwv, "-o", rwv])
check(rc == 0 and "not applicable to DSD" in out, "expected DSD warning on re-encode")
rc, out = run([WVUNPACK, "-y", "-q", "-r", rwv, "-o", raw])
with open(raw, "rb") as f:
    check(f.read() == dsd_reference, "DSD payload altered by --pre-quantize on re-encode")

# ---------------------------------------------------------------------------

if failures:
    print("\n%d pre-quantize check(s) FAILED" % len(failures))
    sys.exit(1)
print("all pre-quantize checks passed (%d matrix cells, %d inputs)" %
      (len(MATRIX), sum(len(v) for v in INPUTS.values())))
PYEOF
