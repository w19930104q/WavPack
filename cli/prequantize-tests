#!/bin/bash
# prequantize-tests: end-to-end verification of the --pre-quantize contract
# documented in doc/pre-quantize.md. For every cell of a hardcoded matrix
# (input bit depth x pre-quantize bits x rounding -> expected samples and
# expected MD5) this script encodes a known input, then checks that
#   1. the decoded samples equal the hardcoded expected samples,
#   2. the MD5 stored in the WavPack file equals the hardcoded expected MD5,
#   3. the decoded file still declares the source bit depth,
#   4. the hardcoded matrix itself matches the documented public rounding
#      rule applied to the test inputs (guards doc <-> test drift),
#   5. DSD sources (fresh encode and re-encode) ignore the option with a
#      warning instead of corrupting the stream.
#
# Run from anywhere: ./cli/prequantize-tests
# Binary locations can be overridden with the WAVPACK and WVUNPACK env vars.

set -e
here="$(cd "$(dirname "$0")" && pwd)"
root="$(dirname "$here")"

find_tool () {
    local varname="$1" prog="$2"
    if [ -n "${!varname}" ]; then return; fi
    for cand in "$root/build/$prog" "$root/cli/$prog" "$root/$prog"; do
        if [ -x "$cand" ]; then eval "$varname=\"$cand\""; return; fi
    done
    echo "cannot find $prog; set $varname" >&2
    exit 1
}

find_tool WAVPACK wavpack
find_tool WVUNPACK wvunpack
export WAVPACK WVUNPACK

if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required for prequantize-tests" >&2
    exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
export WORK="$work"

python3 -I - <<'PYEOF'
